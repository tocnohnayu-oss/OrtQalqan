# Node.js server. Development: npm run dev. Built app: npm run build && npm start.
# On deployment, use the exact HTTPS origin, a persistent database volume and PORT.
# dev/preview serve both UI and API on 5173/4173 in one Vite process.
# PORT applies to the standalone production server; npm start defaults to 8787.
# For deployment, uncomment and replace with the exact external HTTPS origin:
# ORTQALQAN_ORIGIN=https://ortqalqan.example
ORTQALQAN_DATABASE=var/ortqalqan.sqlite
ORTQALQAN_HOST=127.0.0.1
PORT=8787
